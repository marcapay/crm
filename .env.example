# ------------------------------------------------------------------------------
# ARAÚJO IMÓVEIS CRM - CONFIGURAÇÕES DO CLIENTE
# ------------------------------------------------------------------------------

# 1. Configurações de Branding e Identidade Visual do Cliente
VITE_CLIENT_NAME=Araújo Imóveis
VITE_CLIENT_SUBTITLE=CRECI-MGJ 08993

# 2. Banco de Dados e Integração (Persistência em Nuvem)
# Troque este valor para cada novo cliente para criar um banco de dados KV isolado!
KV_BUCKET_ID=araujo_imoveis_crm

# 3. Informações do Administrador Padrão (Criado no primeiro login)
VITE_DEFAULT_ADMIN_NAME=Araújo Imóveis Admin
VITE_DEFAULT_ADMIN_EMAIL=contato@araujoimoveis.com.br

# 4. Evolution API - Configurações de Integração de WhatsApp (Seguro / Backend)
VITE_EVO_BASE_URL=https://sua-instancia-evolution.com
EVO_API_KEY=sua_api_key_aqui
EVO_TENANT=araujo_imoveis
